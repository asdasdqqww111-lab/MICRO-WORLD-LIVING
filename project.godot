; Micro World: Living — vertical slice
; Godot 4.4 / GDScript (typed) / Mobile (Vulkan) renderer
config_version=5

[application]

config/name="Micro World: Living"
config/description="Polished Stylized/Chibi PBR Mobile 3D fantasy open-world RPG in Eldoria. Godot 4.4 Vulkan Mobile, offline-first."
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.09, 0.12, 1)
config/version="3.0.0"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
SceneManager="*res://scripts/core/scene_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
environment/ssao/quality=0
environment/ssao/half_size=true
environment/defaults/default_clear_color=Color(0.58, 0.74, 0.90, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="interactable"
3d_physics/layer_5="npc"
